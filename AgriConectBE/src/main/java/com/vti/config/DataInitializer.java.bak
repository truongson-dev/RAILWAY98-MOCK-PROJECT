                "[\"CÒN HÀNG\"]",
                "Ớt chỉ thiên tươi đỏ đều, độ cay nồng đạt chuẩn, trái cứng bóng không bị dập.",
                "https://lh3.googleusercontent.com/aida-public/AB6AXuBxI345X2u01j04OQjA_YyF7oT7c_a0O1p7cI3-uX_M2n0R1o6Y2rXbTqP5L_W70MvR07g_L_o4vW2m_W8K7LqO3xJ_9E_0Oq2VqWqK5VbT2qO3W_W9o4R2L3Q0oO3M1gXbT7RqT7M0OqK1g_a4r2bT_w4v2Xb2O3xJ2YyM1OqK7a0OqO3M1g_a4r2",
