    private Category createCategory(String name, String code, String desc) {
        return categoryRepository.save(Category.builder().name(name).code(code).description(desc).build());
    }

    private Product createProduct(Account seller, Category category, String name, String nameEn,
                                  double price, int minOrder, String location, String badges,
                                  String desc, String imgUrl, String harvestDate, double rating, int reviews) {
        Product p = Product.builder()
                .seller(seller)
                .category(category)
                .name(name)
                .nameEn(nameEn)
                .price(new BigDecimal(String.valueOf(price)))
                .minOrderKg(minOrder)
                .location(location)
                .badges(badges)
                .description(desc)
                .harvestDate(harvestDate)
                .rating(rating)
                .reviewsCount(reviews)
                .build();
        
        ProductImage pi = ProductImage.builder().product(p).imageUrl(imgUrl).isPrimary(true).build();
        p.getImages().add(pi);
        return productRepository.save(p);
    }
}
