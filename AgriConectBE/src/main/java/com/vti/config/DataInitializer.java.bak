        AuditLog alog1 = AuditLog.builder().actionType("APPROVE_KYC").title("Phê duyệt KYC").subtitle("Phê duyệt hồ sơ KYC cho HTX Nông nghiệp Xanh Đà Lạt").author("admin@agriconnect.vn").createdAt("2026-06-28T10:00:00").build();
