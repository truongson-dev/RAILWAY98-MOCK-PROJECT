        inventoryBatchRepository.saveAll(List.of(ib1, ib2));

        // KycProfile - dùng đúng field names
        KycProfile kyc1 = KycProfile.builder().account(supplier).businessName("HTX Nông nghiệp Xanh Đà Lạt").businessType("Hợp tác xã").taxCode("3801234567").representative("Trần Văn Phúc").status("APPROVED").build();
